// AVL validation rule grammar

start: avl_rule

avl_rule: "WHEN" bool_expr "THEN" bool_expr "GROUP BY" str_list

// BOOL_EXPR: literals, NOT, AND/OR, comparisons
?bool_expr: bool_or

?bool_or: bool_and
        | bool_or "OR" bool_and   -> bool_or

?bool_and: bool_unary
         | bool_and "AND" bool_unary   -> bool_and

?bool_unary: "NOT" bool_unary   -> bool_not
           | bool_atom

?bool_atom: bool_lit
          | compare_expr
          | all_equal_expr
          | expr
          | "(" bool_expr ")"

bool_lit: "ALWAYS"   -> bool_true
        | "TRUE"     -> bool_true
        | "NEVER"    -> bool_false
        | "FALSE"    -> bool_false

compare_expr: compare_operand COMPARE_OP compare_operand   -> compare

compare_operand: expr
               | pos_int
               | string_literal

COMPARE_OP: LE | GE | NE | LT | GT | EQ
LE: "<="
GE: ">="
NE: "!="
LT: "<"
GT: ">"
EQ: "="

// EXPR: column reference or current round
?expr: col_expr
     | current_round_expr

col_expr: "COL" "(" col_name col_round? ")"

col_round: "," "ROUND" "=" int_expr

col_name: COL_NAME

current_round_expr: "CURRENT_ROUND" "(" ")"

all_equal_expr: "ALL_EQUAL" "(" col_expr ")"

// INT_EXPR: integer arithmetic resolved at parse time
?int_expr: int_atom
         | int_atom "-" pos_int   -> int_sub

int_atom: pos_int
        | current_round_expr

str_list: str ("," str)*

str: ESCAPED_STRING

string_literal: ESCAPED_STRING

pos_int: INT

COL_NAME: /[A-Za-z_][A-Za-z0-9_]*/

%import common.INT
%import common.ESCAPED_STRING
%import common.WS
%ignore WS
