// AVL validation rule grammar

start: avl_rule

avl_rule: "WHEN" bool_expr "THEN" bool_expr "GROUP BY" str_list

// BOOL_EXPR: literals, NOT, AND/OR, comparisons
?bool_expr: bool_or

?bool_or: bool_and
        | bool_or "OR" bool_and   -> bool_or

?bool_and: bool_unary
         | bool_and "AND" bool_unary   -> bool_and

?bool_unary: "NOT" bool_unary   -> bool_not
           | bool_atom

?bool_atom: bool_lit
          | compare_expr
          | all_equal_expr
          | any_all_expr
          | is_null_expr
          | expr
          | "(" bool_expr ")"

bool_lit: "ALWAYS"   -> bool_true
        | "TRUE"     -> bool_true
        | "NEVER"    -> bool_false
        | "FALSE"    -> bool_false

compare_expr: compare_operand COMPARE_OP compare_operand   -> compare

compare_operand: expr
               | pos_int
               | string_literal

COMPARE_OP: LE | GE | NE | LT | GT | EQ
LE: "<="
GE: ">="
NE: "!="
LT: "<"
GT: ">"
EQ: "="

?expr: col_expr

col_expr: "COL" "(" col_name ")"

col_name: COL_NAME

all_equal_expr: "ALL_EQUAL" "(" col_expr ")"

is_null_expr: col_expr "IS" "NULL" -> is_null_expr
             | col_expr "IS" "NOT" "NULL" -> is_not_null_expr

any_all_expr: "ANY" "(" bool_expr_list ")" -> any_expr
            | "ALL" "(" bool_expr_list ")" -> all_expr

bool_expr_list: bool_expr ("," bool_expr)*

str_list: str ("," str)*

str: ESCAPED_STRING

string_literal: ESCAPED_STRING

pos_int: INT

COL_NAME: /[A-Za-z_][A-Za-z0-9_]*/

%import common.INT
%import common.ESCAPED_STRING
%import common.WS
%ignore WS
